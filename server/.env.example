# Copy to .env and fill in. The server checks these at boot and
# refuses to start, naming what is wrong, rather than failing on the
# first request. Production (NODE_ENV=production) is stricter: see the
# notes on each value.

# ── Required ────────────────────────────────────────────────
# Signing key for session JWTs. At least 32 characters in production;
# changing it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Mongo connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/codecaret

# ── Optional ────────────────────────────────────────────────
PORT=5000
# "production" turns on the strict checks, HSTS, generic error
# messages, and serving the built client (below).
NODE_ENV=development

# How long a session lasts. Any ms/vercel duration string.
JWT_EXPIRES_IN=7d

# Where the client is served from: the one origin CORS allows, and
# the base of links in emails. Required in production, and https there.
# When this server also serves the client, it is this server's own
# public origin, e.g. https://codecaret.app.
CLIENT_URL=http://localhost:5173

# Profile cache, rate limits, and signing other devices out after a
# password change. All degrade if this is unset: caching is skipped,
# limits count per process, and old sessions last until they expire.
REDIS_URL=redis://127.0.0.1:6379

# Set when the app runs behind a proxy or load balancer, so req.ip
# reflects the real client and the rate limiter keys on the right
# address. Accepts anything Express's "trust proxy" setting takes.
# Behind one reverse proxy or load balancer (the usual production
# setup), set 1.
TRUST_PROXY=

# ── Serving the client ──────────────────────────────────────
# In production this server also serves the built client from
# ../client/dist, so one process is the whole site. Set
# SERVE_CLIENT=false if the client is hosted separately (a CDN,
# Vercel, Netlify), or CLIENT_DIST to serve a build from elsewhere.
SERVE_CLIENT=
CLIENT_DIST=

# ── Email (password resets) ─────────────────────────────────
# Any SMTP provider (Gmail app password, Brevo, Resend, Postmark,
# SES…). Port 465 means TLS from the start; otherwise STARTTLS.
# Unset: no email is sent; outside production the reset link is
# printed to this server's console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on the email, e.g. CodeCaret <no-reply@codecaret.app>
MAIL_FROM=

# ── OAuth (optional) ────────────────────────────────────────
# Each provider is independent. Leave a provider's values blank and
# its endpoint answers 503 and its button is not rendered at all.

# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web).
# The SAME id must be set as VITE_GOOGLE_CLIENT_ID in client/.env —
# the server verifies that the ID token's audience matches it, so a
# mismatch rejects every sign-in.
GOOGLE_CLIENT_ID=

# GitHub > Settings > Developer settings > OAuth Apps.
# Authorization callback URL must be exactly:
#   http://localhost:5173/signin      (development)
# The client id is also needed by the client as VITE_GITHUB_CLIENT_ID;
# the secret belongs here only and must never reach the browser.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
