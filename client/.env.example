# Copy to .env and adjust for your environment.
#
# Origin of the CodeCaret backend, no trailing slash, reachable from
# the browser. Development: http://localhost:5000.
# Production: leave it UNSET when the API serves the client (the
# default deployment) — the app then calls the origin it was loaded
# from. Set it only when the client is hosted somewhere else.
VITE_SERVER_URL=http://localhost:5000

# ── OAuth client ids (optional) ─────────────────────────────
# Public values — a client id names the application, it does not
# authorise anything. Secrets stay on the server.
# Leave blank and that provider's button is not rendered.

# Must match GOOGLE_CLIENT_ID in server/.env exactly.
VITE_GOOGLE_CLIENT_ID=

# Must match GITHUB_CLIENT_ID in server/.env. The GitHub app's
# callback URL must be <origin>/signin.
VITE_GITHUB_CLIENT_ID=

# ── Public site origin (optional) ───────────────────────────
# Where the client is served, no trailing slash, e.g.
# https://codecaret.app. Link previews (og:image) need absolute URLs;
# leave blank locally and they stay relative.
VITE_SITE_URL=
